{
  "manifest_version": 3,
  "name": "GradPack",
  "description": "Save selected accessible Canvas courses for offline use.",
  "version": "0.1.0",
  "version_name": "0.1.0-alpha.7",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "scripting"],
  "host_permissions": ["https://frankfurtschool.instructure.com/*"],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "action": { "default_title": "Open GradPack" },
  "side_panel": { "default_path": "sidepanel.html" },
  "content_scripts": [
    {
      "matches": ["https://frankfurtschool.instructure.com/*"],
      "js": ["relay.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ]
}
